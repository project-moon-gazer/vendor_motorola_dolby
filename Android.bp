soong_namespace {
}

android_app_import {
    name: "MotoDolbyDax3",
    owner: "motorola",
    apk: "proprietary/app/MotoDolbyDax3/MotoDolbyDax3.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "daxService",
    owner: "motorola",
    apk: "proprietary/system_ext/priv-app/daxService/daxService.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

dex_import {
    name: "com.motorola.frameworks.core.addon",
    owner: "motorola",
    jars: [
        "proprietary/framework/com.motorola.frameworks.core.addon.jar",
    ],
    system_ext_specific: true,
}

dex_import {
    name: "motoaudioeffectsdk",
    owner: "motorola",
    jars: [
        "proprietary/framework/motoaudioeffectsdk.jar",
    ],
    system_ext_specific: true,
}

cc_prebuilt_binary {
    name: "vendor.dolby.hardware.dms@2.1-service",
    owner: "motorola",
    target: {
        android_arm64: {
            srcs: ["proprietary/vendor/bin/hw/vendor.dolby.hardware.dms@2.1-service"],
            shared_libs: [
                "liblog",
                "libutils",
                "libhidlbase",
                "libdapparamstorage",
                "libdlbdsservice",
                "vendor.dolby.hardware.dms@2.1",
                "vendor.dolby.hardware.dms@2.0",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    init_rc: ["proprietary/vendor/etc/init/vendor.dolby.hardware.dms@2.1-service.rc"],
    vintf_fragments: ["proprietary/vendor/etc/vintf/manifest/vendor.dolby.hardware.dms.xml"],
    relative_install_path: "hw",
    soc_specific: true,
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_binary {
    name: "vendor.dolby.media.c2@1.0-service",
    owner: "motorola",
    target: {
        android_arm64: {
            srcs: ["proprietary/vendor/bin/hw/vendor.dolby.media.c2@1.0-service"],
            shared_libs: [
                "libbase",
                "liblog",
                "libcodec2",
                "libutils",
                "android.hardware.media.c2@1.0",
                "android.hardware.media.c2@1.1",
                "libcodec2_hidl@1.0",
                "libcodec2_hidl@1.1",
                "libcodec2_vndk",
                "libhidlbase",
                "libavservices_minijail",
                "libbinder",
                "libcodec2_store_dolby",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    init_rc: ["proprietary/vendor/etc/init/vendor.dolby.media.c2@1.0-service.rc"],
    vintf_fragments: ["proprietary/vendor/etc/vintf/manifest/vendor.dolby.media.c2@1.0-service.xml"],
    relative_install_path: "hw",
    soc_specific: true,
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libdapparamstorage",
    owner: "motorola",
    strip: {
